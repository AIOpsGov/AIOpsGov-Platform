# ===========================================
# Conversation Evaluation System Configuration
# ===========================================
# Copy this file to .env and update with your actual values
# Never commit your actual .env file to version control!

# ===========================================
# Demo Mode Configuration
# ===========================================
# Set to true for local development without Azure resources
# Set to false for production with real Azure backend
VITE_ENABLE_DEMO_MODE=true

# ===========================================
# Azure Function App Configuration
# ===========================================
# Your Azure Function App base URL (replace with your actual Function App name)
VITE_API_BASE_URL=https://your-function-app-name.azurewebsites.net/api

# ===========================================
# Application Behavior Configuration
# ===========================================
# How often to poll for status updates (milliseconds)
VITE_POLLING_INTERVAL=5000

# Maximum number of retry attempts for failed requests
VITE_MAX_RETRIES=3

# Request timeout in milliseconds
VITE_REQUEST_TIMEOUT=30000

# Maximum polling attempts before giving up
VITE_MAX_POLLING_ATTEMPTS=120

# Total polling timeout (10 minutes)
VITE_POLLING_TIMEOUT=600000

# ===========================================
# Retry Configuration
# ===========================================
# Initial delay between retries (milliseconds)
VITE_RETRY_INITIAL_DELAY=1000

# Maximum delay between retries (milliseconds)
VITE_RETRY_MAX_DELAY=10000

# Retry backoff multiplier
VITE_RETRY_BACKOFF_MULTIPLIER=2

# ===========================================
# Feature Flags
# ===========================================
# Enable dark mode toggle in UI
VITE_ENABLE_DARK_MODE=true

# Enable browser notifications for evaluation completion
VITE_ENABLE_NOTIFICATIONS=true

# Enable detailed logging in development
VITE_ENABLE_DEBUG_LOGGING=false

# ===========================================
# Build Configuration
# ===========================================
# Build timestamp (automatically set during build)
VITE_BUILD_TIME=

# Application version (from package.json)
VITE_APP_VERSION=

# ===========================================
# AZURE FUNCTION APP ENVIRONMENT VARIABLES
# ===========================================
# These variables go in your Azure Function App settings, NOT in this frontend .env file!
# Set these using Azure CLI or Azure Portal:
#
# az functionapp config appsettings set \
#   --name YOUR_FUNCTION_APP_NAME \
#   --resource-group YOUR_RESOURCE_GROUP \
#   --settings \
#     APP_INSIGHTS_APP_ID="your-application-insights-app-id" \
#     APP_INSIGHTS_API_KEY="your-application-insights-api-key" \
#     WEBHOOK_URL="https://your-region.webhook.azure-automation.net/webhooks?token=your-token" \
#     CORS_ALLOWED_ORIGINS="https://your-domain.com,http://localhost:3000" \
#     API_TIMEOUT="30000" \
#     MAX_RETRIES="3"
#
# Security Note: These sensitive values should NEVER be in your frontend code!